# Copy to .env and adapt, or export these directly. Only PP_BIND and
# PP_DATABASE have to be right for a local run; the rest have sensible defaults.

# Where to listen. Use 0.0.0.0:8787 when something else terminates TLS in front.
PP_BIND=127.0.0.1:8787

# The SQLite file. Created if it does not exist; put it on a persistent disk.
PP_DATABASE=prettypomodoro.db

# Where a browser can reach this server. The OAuth redirect URIs are built from
# it, so it must match what is registered with Google and Facebook exactly.
PP_PUBLIC_URL=http://127.0.0.1:8787

# How many rows the leaderboard returns at most.
PP_LEADERBOARD_LIMIT=50

# "Continue with Google". Redirect URI:
#   $PP_PUBLIC_URL/v1/auth/oauth/callback/google
# PP_GOOGLE_CLIENT_ID=
# PP_GOOGLE_CLIENT_SECRET=

# "Continue with Facebook". Redirect URI:
#   $PP_PUBLIC_URL/v1/auth/oauth/callback/facebook
# PP_FACEBOOK_APP_ID=
# PP_FACEBOOK_APP_SECRET=

# info, or debug for a line per request.
PP_LOG=info
